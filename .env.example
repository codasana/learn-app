# Neon Postgres — use the POOLED connection string ("-pooler" in the host)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic — writing feedback drafts. Server-side only, never exposed.
ANTHROPIC_API_KEY=""

# Cloudflare R2 (S3-compatible). Private bucket; signed URLs only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="english-ladder"

# Automette — certificates, reports, achievement cards, share cards.
# We are a CUSTOMER of Automette: public API only, never its database.
AUTOMETTE_API_BASE="https://automette.com/api/v1"
AUTOMETTE_API_KEY=""

# Set once the "Book a free class" form exists in Automette.
AUTOMETTE_FORM_SECRET=""
AUTOMETTE_FORM_URL=""

# Amazon SES. Sending is best-effort everywhere: unset means nothing is sent
# and a warning is logged, never a failed enquiry.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_SES_CONFIGURATION_SET=""
EMAIL_FROM="English Ladder <noreply@example.com>"

# Where the teacher's alerts go, and the reply-to on mail we send parents.
TEACHER_EMAIL=""

# Cal.com — where a parent books the free class, in their own timezone.
# Sheeba's event type, e.g. https://cal.com/sheeba/free-class
# Unset is safe: every screen and email falls back to "she will write to you
# with times" rather than offering a dead link.
CAL_BOOKING_URL=""

# Cal.com webhook signing secret, from the webhook's settings page.
# Subscribe it to BOOKING_CREATED, BOOKING_RESCHEDULED and BOOKING_CANCELLED.
CAL_WEBHOOK_SECRET=""

# Loops — lead nurture. We push stage changes and never read them back.
# Unset means every sync is a silent no-op; nothing else changes.
LOOPS_API_KEY=""

# Only when the production origin cannot be read from Vercel's own env.
APP_ORIGIN=""
